# Google Analytics 4 measurement ID, from Admin > Data Streams > your stream.
# Production builds read the GitHub repository variable of the same name.
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Add the real publication homepage after creating it; leave empty until then.
NEXT_PUBLIC_SUBSTACK_URL=

# Optional HTML-tag ownership verification values supplied by Search Console / Bing.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
